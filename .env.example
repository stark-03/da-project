# Copy to .env and adjust. Never commit .env.

# development | production | testing
APP_ENV=development

# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Database. Default (empty) = SQLite file at instance/app.db
# MySQL example: mysql+pymysql://user:password@localhost:3306/rental_scam_detector?charset=utf8mb4
DATABASE_URL=

# Tesseract OCR binary. Leave empty if "tesseract" is on PATH.
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
# Tesseract language(s), e.g. eng or eng+hin (language packs must be installed)
OCR_LANG=eng
OCR_TIMEOUT_SECONDS=60

# Where uploaded document images are stored (private, never under static/).
# Default (empty) = instance/uploads
UPLOAD_FOLDER=

# Upload limits
MAX_UPLOAD_MB=8

# Days to keep uploaded images and extracted text before `flask --app run purge-expired` deletes them
RETENTION_DAYS=30

# Set to 1 when served over HTTPS (forced on in production)
SESSION_COOKIE_SECURE=0

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
